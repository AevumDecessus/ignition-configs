variant: fcos
version: 1.5.0
ignition:
  config:
    merge:
      - local: ./ignition/ucore/merge-ucore.ign
      - local: ./ignition/mounts/music.ign
      - local: ./ignition/mounts/docker/music.ign
      - local: ./ignition/motd/music.ign
      - local: ./ignition/common/semodules/base.ign
      - local: ./ignition/common/semodules/periphery.ign
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: docker-music.home.0n5.us
    - path: /etc/NetworkManager/system-connections/ens18.nmconnection
      overwrite: false
      mode: 0600
      contents:
        inline: |
          [connection]
          id=ens18
          type=ethernet
          interface-name=ens18
          [ipv4]
          dns=192.168.202.31
          dns-search=home.0n5.us
          may-fail=false
          method=manual
          address1=192.168.202.58/23,192.168.202.1
          dhcp-hostname=docker-music.home.0n5.us
